<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ORIS — Quarry Intelligence</title>

    <style>
        :root {
            --bg: #f4f7fb;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --border: #e5eaf1;
            --text: #162033;
            --muted: #667085;
            --primary: #2457d6;
            --primary-dark: #1945b0;
            --success: #15803d;
            --success-bg: #ecfdf3;
            --warning: #b45309;
            --warning-bg: #fff7ed;
            --danger: #b42318;
            --danger-bg: #fef3f2;
            --shadow: 0 12px 32px rgba(16, 24, 40, 0.07);
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
            background:
                radial-gradient(
                    circle at top right,
                    rgba(36, 87, 214, 0.08),
                    transparent 32%
                ),
                var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ---------------- Header ---------------- */

        header {
            background: #111827;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .header-inner {
            max-width: 1240px;
            margin: 0 auto;
            padding: 24px 24px 26px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-mark {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #3974ed, #2457d6);
            box-shadow: 0 8px 24px rgba(36, 87, 214, 0.35);
            font-size: 22px;
            font-weight: 800;
        }

        .brand h1 {
            margin: 0;
            font-size: 24px;
            letter-spacing: -0.4px;
        }

        .brand p {
            margin: 3px 0 0;
            color: #aeb8c8;
            font-size: 13px;
        }

        .system-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 999px;
            color: #dbe4f2;
            font-size: 13px;
            background: rgba(255,255,255,0.05);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 0 4px rgba(52,211,153,0.12);
        }

        /* ---------------- Layout ---------------- */

        main {
            max-width: 1240px;
            margin: 0 auto;
            padding: 30px 24px 60px;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        /* ---------------- Search ---------------- */

        .search-card {
            padding: 28px;
            margin-bottom: 22px;
        }

        .section-heading {
            margin-bottom: 24px;
        }

        .eyebrow {
            margin: 0 0 7px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .section-heading h2 {
            margin: 0;
            font-size: 22px;
            letter-spacing: -0.4px;
        }

        .section-heading p {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .search-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .field label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 700;
            color: #344054;
        }

        .field input {
            width: 100%;
            height: 48px;
            padding: 0 14px;
            border: 1px solid #d5dce7;
            border-radius: 10px;
            background: #fff;
            color: var(--text);
            font-size: 15px;
            outline: none;
            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .field input:hover {
            border-color: #b7c1d0;
        }

        .field input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(36, 87, 214, 0.10);
        }

        .search-actions {
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .search-hint {
            color: var(--muted);
            font-size: 13px;
        }

        button {
            height: 46px;
            padding: 0 22px;
            border: 0;
            border-radius: 10px;
            background: var(--primary);
            color: white;
            font-size: 14px;
            font-weight: 750;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(36, 87, 214, 0.22);
            transition:
                transform 0.15s ease,
                background 0.15s ease,
                box-shadow 0.15s ease;
        }

        button:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(36, 87, 214, 0.28);
        }

        button:active {
            transform: translateY(0);
        }

        button:disabled {
            background: #98a2b3;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        /* ---------------- Status ---------------- */

        .status {
            display: none;
            padding: 20px 24px;
            margin-bottom: 22px;
        }

        .status.visible {
            display: block;
        }

        .status-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 12px;
        }

        .status-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .status-text {
            margin-top: 4px;
            font-size: 16px;
            font-weight: 750;
        }

        .job-id {
            color: var(--muted);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 11px;
            text-align: right;
            word-break: break-all;
        }

        .progress-container {
            width: 100%;
            height: 8px;
            background: #edf1f6;
            border-radius: 999px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #2457d6, #4f83f1);
            border-radius: inherit;
            transition: width 0.4s ease;
        }

        .status-footer {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 12px;
        }

        /* ---------------- Results ---------------- */

        .results-card {
            padding: 28px;
        }

        .results-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            padding-bottom: 18px;
            border-bottom: 1px solid var(--border);
        }

        .results-header h2 {
            margin: 0;
            font-size: 21px;
            letter-spacing: -0.3px;
        }

        .result-count {
            color: var(--muted);
            font-size: 13px;
            font-weight: 650;
        }

        /* ---------------- Result Cards ---------------- */

        .quarry {
            margin-top: 14px;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: white;
            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }

        .quarry:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 24px rgba(16, 24, 40, 0.06);
            transform: translateY(-1px);
        }

        .quarry-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
        }

        .quarry h3 {
            margin: 0;
            font-size: 17px;
            letter-spacing: -0.2px;
        }

        .location-line {
            margin-top: 7px;
            color: var(--muted);
            font-size: 13px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            flex-shrink: 0;
            padding: 6px 10px;
            border-radius: 999px;
            background: #eef2f7;
            color: #475467;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .badge.extracted {
            background: var(--success-bg);
            color: var(--success);
        }

        .badge.no-website,
        .badge.crawl-failed,
        .badge.http_403 {
            background: var(--warning-bg);
            color: var(--warning);
        }

        .quarry-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 16px;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 8px;
            background: var(--surface-soft);
            color: #475467;
            font-size: 12px;
            border: 1px solid #eef2f6;
        }

        .meta-pill strong {
            color: #344054;
        }

        .website {
            margin-top: 14px;
            padding: 11px 13px;
            border-radius: 9px;
            background: #f5f8ff;
            border: 1px solid #e2eaff;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .website-label {
            color: var(--muted);
            font-weight: 650;
            margin-right: 5px;
        }

        .website a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 650;
        }

        .website a:hover {
            text-decoration: underline;
        }

        /* ---------------- Facts ---------------- */

        .facts {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-top: 16px;
        }

        .fact {
            padding: 14px;
            border: 1px solid #edf0f5;
            border-radius: 10px;
            background: var(--surface-soft);
        }

        .fact strong {
            display: block;
            margin-bottom: 6px;
            color: #344054;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .fact-value {
            color: var(--text);
            font-size: 14px;
            line-height: 1.5;
        }

        .confidence {
            margin-top: 6px;
            color: var(--muted);
            font-size: 11px;
        }

        .materials {
            margin-top: 10px;
            padding: 14px;
            border-radius: 10px;
            background: #f8fafc;
            border: 1px solid #edf0f5;
        }

        .materials-title {
            margin-bottom: 9px;
            color: #344054;
            font-size: 12px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .material-list {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .material {
            padding: 6px 9px;
            border-radius: 7px;
            background: white;
            border: 1px solid #e3e8ef;
            color: #475467;
            font-size: 12px;
        }

        /* ---------------- Evidence ---------------- */

        .evidence {
            margin-top: 16px;
            padding: 15px 16px;
            background: #fffaf5;
            border: 1px solid #fde7d2;
            border-left: 4px solid #f97316;
            border-radius: 10px;
        }

        .evidence-header {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #9a3412;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .evidence blockquote {
            margin: 9px 0 0;
            color: #475467;
            font-size: 13px;
            line-height: 1.55;
        }

        /* ---------------- Empty / Error ---------------- */

        .empty {
            padding: 55px 20px;
            text-align: center;
            color: var(--muted);
        }

        .empty-icon {
            width: 44px;
            height: 44px;
            margin: 0 auto 12px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #eef3ff;
            color: var(--primary);
            font-size: 20px;
        }

        .empty strong {
            display: block;
            margin-bottom: 5px;
            color: #344054;
            font-size: 14px;
        }

        .error {
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 9px;
            border: 1px solid #fecdca;
            background: var(--danger-bg);
            color: var(--danger);
            font-size: 13px;
        }

        /* ---------------- Responsive ---------------- */

        @media (max-width: 800px) {
            .header-inner {
                align-items: flex-start;
            }

            .system-status {
                display: none;
            }

            .search-grid {
                grid-template-columns: 1fr;
            }

            .search-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .search-actions button {
                width: 100%;
            }

            .status-top {
                align-items: flex-start;
                flex-direction: column;
            }

            .job-id {
                text-align: left;
            }
        }

        @media (max-width: 600px) {
            main {
                padding: 18px 12px 40px;
            }

            .header-inner {
                padding: 18px 16px;
            }

            .search-card,
            .results-card {
                padding: 20px;
            }

            .facts {
                grid-template-columns: 1fr;
            }

            .quarry-top {
                flex-direction: column;
            }

            .badge {
                align-self: flex-start;
            }

            .results-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 6px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="header-inner">
        <div class="brand">
            <div class="brand-mark">O</div>

            <div>
                <h1>ORIS</h1>
                <p>Quarry Intelligence &amp; Research System</p>
            </div>
        </div>

        <div class="system-status">
            <span class="status-dot"></span>
            System ready
        </div>
    </div>
</header>

<main>

    <!-- Search -->
    <section class="card search-card">

        <div class="section-heading">
            <p class="eyebrow">Discovery</p>
            <h2>Search for quarry sites</h2>
            <p>
                Discover quarry locations and enrich available site information.
            </p>
        </div>

        <div class="search-grid">

            <div class="field">
                <label for="latitude">Latitude</label>
                <input
                    id="latitude"
                    type="number"
                    step="any"
                    value="48.8566"
                >
            </div>

            <div class="field">
                <label for="longitude">Longitude</label>
                <input
                    id="longitude"
                    type="number"
                    step="any"
                    value="2.3522"
                >
            </div>

            <div class="field">
                <label for="radius">Search radius (km)</label>
                <input
                    id="radius"
                    type="number"
                    min="0.1"
                    step="0.1"
                    value="10"
                >
            </div>

        </div>

        <div class="search-actions">
            <div class="search-hint">
                Coordinates can be entered as decimal degrees.
            </div>

            <button id="searchButton" onclick="startSearch()">
                Search Quarries
            </button>
        </div>

    </section>


    <!-- Job status -->
    <section id="statusCard" class="card status">

        <div class="status-top">

            <div>
                <div class="status-label">Job status</div>

                <div id="statusText" class="status-text">
                    Queued
                </div>
            </div>

            <div id="jobId" class="job-id"></div>

        </div>

        <div class="progress-container">
            <div id="progressBar" class="progress-bar"></div>
        </div>

        <div class="status-footer">
            <span>Processing pipeline</span>
            <span id="progressPercent">0%</span>
        </div>

        <div id="jobError"></div>

    </section>


    <!-- Results -->
    <section class="card results-card">

        <div class="results-header">

            <div>
                <p class="eyebrow">Results</p>
                <h2>Discovered sites</h2>
            </div>

            <span id="resultCount" class="result-count"></span>

        </div>

        <div id="results">
            <div class="empty">
                <div class="empty-icon">⌖</div>
                <strong>No search results yet</strong>
                Run a search to discover quarry sites.
            </div>
        </div>

    </section>

</main>


<script>

let pollingTimer = null;


async function startSearch() {

    const button = document.getElementById("searchButton");

    const latitude = Number(
        document.getElementById("latitude").value
    );

    const longitude = Number(
        document.getElementById("longitude").value
    );

    const radius = Number(
        document.getElementById("radius").value
    );

    if (
        !Number.isFinite(latitude) ||
        !Number.isFinite(longitude) ||
        !Number.isFinite(radius)
    ) {
        showError(
            "Please enter valid search coordinates and radius."
        );
        return;
    }

    button.disabled = true;
    button.textContent = "Searching...";

    document
        .getElementById("statusCard")
        .classList.add("visible");

    document.getElementById("results").innerHTML = "";
    document.getElementById("resultCount").textContent = "";

    setStatus("Submitting job...", 0);

    try {

        const response = await fetch(
            "/api/jobs",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    latitude: latitude,
                    longitude: longitude,
                    radius_km: radius
                })
            }
        );

        if (!response.ok) {
            throw new Error(
                `Job creation failed (${response.status})`
            );
        }

        const job = await response.json();

        document.getElementById("jobId").textContent =
            `Job ID: ${job.job_id}`;

        pollJob(job.job_id);

    } catch (error) {

        showError(error.message);

        button.disabled = false;
        button.textContent = "Search Quarries";
    }
}


async function pollJob(jobId) {

    if (pollingTimer) {
        clearTimeout(pollingTimer);
    }

    try {

        const response = await fetch(
            `/api/jobs/${jobId}`
        );

        if (!response.ok) {
            throw new Error(
                `Unable to retrieve job (${response.status})`
            );
        }

        const job = await response.json();

        const progress =
            typeof job.progress === "number"
                ? job.progress
                : 0;

        setStatus(
            formatStatus(job.status),
            progress
        );

        if (job.status === "completed") {

            document.getElementById("searchButton")
                .disabled = false;

            document.getElementById("searchButton")
                .textContent = "Search Again";

            renderResults(job.result);

            return;
        }

        if (job.status === "failed") {

            showError(
                job.error || "The job failed."
            );

            document.getElementById("searchButton")
                .disabled = false;

            document.getElementById("searchButton")
                .textContent = "Try Again";

            return;
        }

        pollingTimer = setTimeout(
            () => pollJob(jobId),
            1000
        );

    } catch (error) {

        showError(error.message);

        document.getElementById("searchButton")
            .disabled = false;

        document.getElementById("searchButton")
            .textContent = "Try Again";
    }
}


function setStatus(status, progress) {

    document.getElementById("statusText")
        .textContent = status;

    const percent = Math.max(
        0,
        Math.min(100, progress * 100)
    );

    document.getElementById("progressBar")
        .style.width = `${percent}%`;

    document.getElementById("progressPercent")
        .textContent = `${Math.round(percent)}%`;

    document.getElementById("jobError")
        .innerHTML = "";
}


function formatStatus(status) {

    const labels = {
        queued: "Queued",
        running: "Processing",
        completed: "Completed",
        failed: "Failed"
    };

    return labels[status] || status;
}


function renderResults(result) {

    if (
        !result ||
        !Array.isArray(result.results)
    ) {
        document.getElementById("results").innerHTML =
            `
            <div class="empty">
                <div class="empty-icon">!</div>
                <strong>No results returned</strong>
                The job completed without result data.
            </div>
            `;

        return;
    }

    document.getElementById("resultCount")
        .textContent =
        `${result.count} site${result.count === 1 ? "" : "s"}`;

    if (result.results.length === 0) {

        document.getElementById("results").innerHTML =
            `
            <div class="empty">
                <div class="empty-icon">⌖</div>
                <strong>No quarries found</strong>
                Try increasing the search radius.
            </div>
            `;

        return;
    }

    const container =
        document.getElementById("results");

    container.innerHTML = "";

    result.results.forEach(item => {

        const quarry = item.quarry;
        const extraction = item.extraction;

        const card =
            document.createElement("div");

        card.className = "quarry";

        const statusClass =
            item.status === "extracted"
                ? "extracted"
                : item.status;

        card.innerHTML = `

            <div class="quarry-top">

                <div>
                    <h3>
                        ${escapeHtml(
                            quarry.name || "Unnamed Quarry"
                        )}
                    </h3>

                    <div class="location-line">
                        ${escapeHtml(
                            quarry.municipality ||
                            "Municipality not established"
                        )}
                    </div>
                </div>

                <span class="badge ${escapeHtml(statusClass)}">
                    ${escapeHtml(item.status)}
                </span>

            </div>

            <div class="quarry-meta">

                <span class="meta-pill">
                    <strong>Coordinates</strong>
                    ${quarry.latitude.toFixed(5)},
                    ${quarry.longitude.toFixed(5)}
                </span>

                <span class="meta-pill">
                    <strong>Distance</strong>
                    ${quarry.distance_km} km
                </span>

                <span class="meta-pill">
                    <strong>Source</strong>
                    ${escapeHtml(
                        quarry.source || "OpenStreetMap"
                    )}
                </span>

            </div>

            ${
                quarry.website
                    ? `
                    <div class="website">
                        <span class="website-label">
                            Official website
                        </span>

                        <a
                            href="${escapeAttribute(
                                quarry.website
                            )}"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            ${escapeHtml(quarry.website)}
                        </a>
                    </div>
                    `
                    : ""
            }

            ${
                extraction
                    ? renderExtraction(extraction)
                    : ""
            }

        `;

        container.appendChild(card);
    });
}


function renderExtraction(extraction) {

    const fields = [
        ["Official name", extraction.official_name],
        ["Site type", extraction.site_type],
        ["Description", extraction.description],
        ["Operational status", extraction.operational_status]
    ];

    let html = '<div class="facts">';

    fields.forEach(([label, field]) => {

        if (!field) {
            return;
        }

        const value =
            field.value !== null &&
            field.value !== undefined
                ? field.value
                : "Not established";

        html += `
            <div class="fact">

                <strong>
                    ${escapeHtml(label)}
                </strong>

                <div class="fact-value">
                    ${escapeHtml(
                        Array.isArray(value)
                            ? value.join(", ")
                            : String(value)
                    )}
                </div>

                <div class="confidence">
                    Confidence:
                    ${(Number(
                        field.confidence || 0
                    ) * 100).toFixed(0)}%
                </div>

            </div>
        `;
    });

    html += "</div>";


    if (
        Array.isArray(
            extraction.materials_produced
        ) &&
        extraction.materials_produced.length
    ) {

        const materials =
            extraction.materials_produced
                .map(item => {
                    const value =
                        item.value ??
                        "Not established";

                    return `
                        <span class="material">
                            ${escapeHtml(String(value))}
                        </span>
                    `;
                })
                .join("");

        html += `
            <div class="materials">

                <div class="materials-title">
                    Materials
                </div>

                <div class="material-list">
                    ${materials}
                </div>

            </div>
        `;
    }


    const evidence =
        collectEvidence(extraction);

    if (evidence.length) {

        html += `
            <div class="evidence">

                <div class="evidence-header">
                    Evidence
                </div>
        `;

        evidence.forEach(item => {

            html += `
                <blockquote>
                    "${escapeHtml(item.quote)}"
                </blockquote>
            `;
        });

        html += "</div>";
    }

    return html;
}


function collectEvidence(extraction) {

    const evidence = [];

    Object.values(extraction)
        .forEach(field => {

            if (
                !field ||
                !Array.isArray(field.evidence)
            ) {
                return;
            }

            field.evidence.forEach(item => {

                if (
                    item &&
                    item.quote &&
                    !evidence.some(
                        existing =>
                            existing.source_id ===
                                item.source_id &&
                            existing.char_start ===
                                item.char_start &&
                            existing.char_end ===
                                item.char_end
                    )
                ) {
                    evidence.push(item);
                }
            });

        });

    return evidence;
}


function showError(message) {

    document.getElementById("jobError")
        .innerHTML = `
            <div class="error">
                ${escapeHtml(message)}
            </div>
        `;
}


function escapeHtml(value) {

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function escapeAttribute(value) {
    return escapeHtml(value);
}

</script>

</body>
</html>
